# Copy this file to .env and fill in the blank secrets locally.
# .env is gitignored. Do not commit passwords or WooCommerce API keys.

MARIADB_ROOT_PASSWORD=
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=

WORDPRESS_URL=http://localhost:8080
WORDPRESS_TITLE=Local Store
WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_PASSWORD=
WORDPRESS_ADMIN_EMAIL=

# Used by the WooCommerce MCP container. The hostname "wordpress" is the
# Compose service, not the browser address. Leave the key and secret empty
# until you create them in WooCommerce admin.
WOOCOMMERCE_BASE_URL=http://wordpress
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_TIMEOUT_SECONDS=8

# Optional. Empty means the upstream is enabled. Set one to false to hide it.
WOOCOMMERCE_MCP_ENABLED=
SUPPORT_MCP_ENABLED=
UTILITY_MCP_ENABLED=

# Optional. Empty or open: any live gateway key can read GET /admin/status.
# Set to required only after granting gateway__read_status to the dashboard key.
# Any other value stops the gateway from starting. This does not grant tools.
GATEWAY_STATUS_PERMISSION=

# Optional. At least 32 characters, for example the output of: openssl rand -base64 32
# Leave empty until you store dynamic upstream credentials. Compose does not pass this
# into the gateway container unless you add it to that service.
GATEWAY_UPSTREAM_KEY=
# Optional. Previous key, used only while ciphertext is rewritten after a rotation.
GATEWAY_UPSTREAM_KEY_PREVIOUS=

# Optional. Without it, dashboard chat returns 503. Compose does not pass this
# into the gateway container unless you add it to that service.
CHAT_API_KEY=
CHAT_MAX_TOOL_CALLS=4
CHAT_PROVIDER_TIMEOUT_SECONDS=20

# Optional gateway process settings. Compose sets the upstream timeout to 20.
UPSTREAM_TIMEOUT_SECONDS=5
UPSTREAM_ALLOW_PRIVATE=true
UPSTREAM_TRUST_ENVIRONMENT=true
GATEWAY_COOKIE_SECURE=false

# Gateway authentication database. This is separate from MariaDB.
# Use a long random password made of letters and digits. If the password
# contains any other character, percent-encode it in GATEWAY_DATABASE_URL.
GATEWAY_DB_PASSWORD=
# Used when the gateway runs on the host. Compose overrides this inside the gateway container.
GATEWAY_DATABASE_URL=postgresql://gateway:set-the-password-here@127.0.0.1:5432/gateway
